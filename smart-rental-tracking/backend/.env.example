MONGO_URI=mongodb://127.0.0.1:27017/smart-rental-tracking
PORT=5000
TELEMETRY_TIMEOUT_SECONDS=10

# Chatbot (optional). If GROQ_API_KEY is set, POST /api/chat answers questions
# about the fleet using Groq. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Twilio SMS Notifications (Messaging Service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
DUE_SOON_THRESHOLD_MINUTES=60
ALERT_CHECK_INTERVAL_SECONDS=60
